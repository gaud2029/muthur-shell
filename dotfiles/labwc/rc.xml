<!--
  This is a very simple config file with many options missing. For a complete
  set of options with comments, see docs/rc.xml.all
-->

<labwc_config>

  <theme>
    <!-- No <name>: colors come from themerc-override, generated by
         ThemeStore.qml to match the quickshell theme (issue #4-style). -->
    <cornerRadius>0</cornerRadius>
    <font name="sans" size="10" />
    <titlebar>
      <!-- No icon button; title left-aligned via
           window.label.text.justify in the generated
           themerc-override (see ThemeStore.qml). -->
      <layout>:iconify,max,close</layout>
      <showTitle>yes</showTitle>
    </titlebar>
  </theme>

  <desktops>
    <!-- The bar shows the active workspace; no labwc OSD on top of it. -->
    <popupTime>0</popupTime>
    <names>
      <name>1</name>
      <name>2</name>
      <name>3</name>
      <name>4</name>
    </names>
  </desktops>

  <keyboard>
    <default />
    <!-- Workspaces: Super+N to go, Super+Shift+N to send the window along -->
    <keybind key="W-1"><action name="GoToDesktop" to="1" /></keybind>
    <keybind key="W-2"><action name="GoToDesktop" to="2" /></keybind>
    <keybind key="W-3"><action name="GoToDesktop" to="3" /></keybind>
    <keybind key="W-4"><action name="GoToDesktop" to="4" /></keybind>
    <keybind key="W-S-1"><action name="SendToDesktop" to="1" /></keybind>
    <keybind key="W-S-2"><action name="SendToDesktop" to="2" /></keybind>
    <keybind key="W-S-3"><action name="SendToDesktop" to="3" /></keybind>
    <keybind key="W-S-4"><action name="SendToDesktop" to="4" /></keybind>
    <!-- Fullscreen the focused window -->
    <keybind key="W-f"><action name="ToggleFullscreen" /></keybind>
    <!-- Terminal -->
    <keybind key="W-Return">
      <action name="Execute" command="alacritty" />
    </keybind>
    <!-- App launcher -->
    <keybind key="W-Space">
      <action name="Execute" command="fuzzel" />
    </keybind>
    <!-- File manager (yazi, in the terminal) -->
    <keybind key="W-e">
      <action name="Execute" command="alacritty -e yazi" />
    </keybind>
    <!--
      Remove a previously defined keybind
      A shorter alternative is <keybind key="W-F4" />
    -->
    <keybind key="W-F4">
      <action name="None" />
    </keybind>
        <!-- Screenshot: full screen -->
    
    <keybind key="W-S-3">
      <action name="Execute">
        <command>sh -c 'mkdir -p "$HOME/Pictures/Screenshots"; grim "$HOME/Pictures/Screenshots/Screenshot-$(date +%Y-%m-%d_%H-%M-%S).png"'</command>
      </action>
    </keybind>

    <!-- Screenshot: select region -->
    <keybind key="W-S-4">
      <action name="Execute">
        <command>sh -c 'mkdir -p "$HOME/Pictures/Screenshots"; grim -g "$(slurp)" "$HOME/Pictures/Screenshots/Screenshot-$(date +%Y-%m-%d_%H-%M-%S).png"'</command>
      </action>
    </keybind>

    <!-- ctrl + super + shift +4 -->
    <keybind key="C-W-S-4">
      <action name="Execute">
        <command>sh -c 'grim -g "$(slurp)" - | wl-copy'</command>
      </action>
    </keybind>
  </keyboard>

  <mouse>
    <default />
    <!-- Show a custom menu on desktop right click -->
    <context name="Root">
      <mousebind button="Right" action="Press">
        <action name="ShowMenu" menu="some-custom-menu" />
      </mousebind>
    </context>
  </mouse>

</labwc_config>
