# Keypress feed for the muthur shell's typing sounds (GitHub issue #21).
# Installed by dotfiles/keysound/install-keysound.sh.
#
# Reads the keyboards as a throwaway user in the `input` group, sandboxed,
# and passes on only "a key, about here" through
# /run/muthur-keysound/events.sock: no user process needs keyboard access,
# and keycodes never leave this service.
[Unit]
Description=muthur typing sounds: keypress feed
After=systemd-udevd.service

[Service]
ExecStart=/usr/bin/python3 /usr/local/lib/muthur/keysound-input.py
Restart=on-failure
DynamicUser=yes
SupplementaryGroups=input
RuntimeDirectory=muthur-keysound
RuntimeDirectoryMode=0755
DevicePolicy=closed
DeviceAllow=char-input r
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
